{
  "1": {
    "inputs": {
      "ckpt_name": "PARAM_MODEL"
    },
    "class_type": "CheckpointLoaderSimple",
    "_meta": { "title": "Load Checkpoint" }
  },
  "2": {
    "inputs": {
      "text": "PARAM_PROMPT",
      "clip": ["1", 1]
    },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Positive Prompt" }
  },
  "3": {
    "inputs": {
      "text": "PARAM_NEGATIVE_PROMPT",
      "clip": ["1", 1]
    },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Negative Prompt" }
  },
  "4": {
    "inputs": {
      "width": 576,
      "height": 768,
      "batch_size": 1
    },
    "class_type": "EmptyLatentImage",
    "_meta": { "title": "Canvas 576x768 (3:4)" }
  },
  "5": {
    "inputs": {
      "seed": "PARAM_INT_SEED",
      "steps": "PARAM_INT_STEPS",
      "cfg": "PARAM_FLOAT_CFG",
      "sampler_name": "PARAM_STR_SAMPLER_NAME",
      "scheduler": "PARAM_STR_SCHEDULER",
      "denoise": "PARAM_FLOAT_DENOISE",
      "model": ["1", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["4", 0]
    },
    "class_type": "KSampler",
    "_meta": { "title": "Sampler - base pass" }
  },
  "6": {
    "inputs": {
      "samples": ["5", 0],
      "upscale_method": "nearest-exact",
      "scale_by": 1.5
    },
    "class_type": "LatentUpscaleBy",
    "_meta": { "title": "Latent Upscale x1.5" }
  },
  "7": {
    "inputs": {
      "seed": "PARAM_INT_SEED",
      "steps": 12,
      "cfg": "PARAM_FLOAT_CFG",
      "sampler_name": "PARAM_STR_SAMPLER_NAME",
      "scheduler": "PARAM_STR_SCHEDULER",
      "denoise": 0.5,
      "model": ["1", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["6", 0]
    },
    "class_type": "KSampler",
    "_meta": { "title": "Sampler - hires fix" }
  },
  "8": {
    "inputs": {
      "samples": ["7", 0],
      "vae": ["1", 2]
    },
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE Decode" }
  },
  "9": {
    "inputs": {
      "filename_prefix": "douyin_cover",
      "images": ["8", 0]
    },
    "class_type": "SaveImage",
    "_meta": { "title": "Save Image" }
  }
}
